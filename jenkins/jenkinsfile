@Library(value='pipeline-utils', changelog=false)_

GIT_COMMIT_HASH = ""
GIT_COMMIT_URL = ""

GEN3_IP = "192.168.1.10"  // IP of the GEN 3

pipeline {
    agent { label "ubuntu24.04" }
    options {
        disableConcurrentBuilds()
        timestamps()
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    GIT_COMMIT_HASH = sh(returnStdout: true, script: 'git rev-parse HEAD').trim()
                    GIT_COMMIT_URL = scm.browser.repoUrl
                }
            }
        }
        stage('Configure JFrog CLI') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'artifactory-python-creds',
                                                  usernameVariable: 'JF_USER',
                                                  passwordVariable: 'JF_PASSWORD')]) {
                    sh '''
                        # Prefer the agent's provisioned ~/.jfrog, as on the ubuntu24.04 agents
                        # (see the agent prerequisites at the top of this file). 'jf c show'
                        # exits 0 either way, so an empty output is what signals "no config".
                        if [ -n "$(jf c show 2>/dev/null)" ]; then
                            echo "Using the JFrog CLI configuration already present on this agent."
                            jf c show
                        else
                            echo "No JFrog CLI configuration on this agent - falling back to the Jenkins credential."
                            jf c add kinova --url="https://artifactory.kinovaapps.com" --user="$JF_USER" --password="$JF_PASSWORD" --interactive=false --overwrite
                            jf c use kinova
                        fi
                    '''
                }
            }
        }
        stage('Python Environement Set Up') {
            steps {
                sh """
                    sudo apt update
                    sudo apt install software-properties-common -y

                    sudo add-apt-repository ppa:deadsnakes/ppa -y
                    sudo apt update

                    sudo apt install python3.9 python3.9-venv python3.9-dev -y

                    python3.9 --version

                    python3.9 -m venv .venv

                    .venv/bin/pip install -r modbus/examples/requirements.txt
                """
            }
        }
        stage('Fetch the Latest GEN3 SWU') {
            steps {
                dir("${WORKSPACE}") {
                    script {

                        def rawJson = sh(returnStdout: true, script: """
                            jf rt s --sort-by created --sort-order desc --fail-no-op --limit 1 --props branch_name=development \
                            generic-local-build/kortex/products/gen3/development/*/Gen3*.swu
                        """).trim()

                        def info = readJSON text: rawJson

                        // In JFrog CLI, properties are stored under props['build.number']
                        if (info && info.size() > 0) {
                            def artifact = info[0]

                            // If 'build.number' is stored in props:
                            def buildNumber = artifact.props?.'build.number'?.get(0) ?: artifact['build.number']

                            env.GEN3_VERSION = buildNumber.toString()
                            echo "GEN3_VERSION assigned: ${env.GEN3_VERSION}"
                        } else {
                            error("No artifacts found matching the query!")
                        }
                    }
                }
            }
        }
        stage('Fetch the Latest Kortex') {
            steps {
                dir("${WORKSPACE}") {
                    script {

                        sh """
                            jf rt dl "generic-public/kortex/API/*/kortex_api-*.post3-py3-none-any.whl" --sort-by=created --sort-order=desc --limit=1
                        """

                        def buildNumber = sh(returnStdout: true, script: """ ls kortex/API """)

                        if (buildNumber && buildNumber.size() > 0) {
                            env.KORTEX_VERSION = buildNumber.toString()
                            echo "KORTEX_VERSION assigned: ${env.KORTEX_VERSION}"
                        } else {
                            error("No artifacts found matching the query!")
                        }

                        sh """
                            python3.9 -m pip install kortex/API/${env.KORTEX_VERSION}/kortex_api-${env.KORTEX_VERSION}.post3-py3-none-any.whl
                        """
                    }
                }
            }
        }
        stage('Run Automated Validation') {
            steps {
                // Running the Pytest command
                script {
                    // Python
                    sh """
                        python3.9 api_python/examples/000-Getting_Started/01-api_creation.py
                    """
                    
                    // C++
                }
            }
        }
    }
    post {
        always {
            // Current build description
            script {
                if (GIT_COMMIT_HASH) {
                    currentBuild.description = "Commit: <a href='${GIT_COMMIT_URL}/commits/${GIT_COMMIT_HASH}'>${GIT_COMMIT_HASH}</a><br />"
                }
                if (env.SUT_RELEASE) {
                    currentBuild.description = (currentBuild.description ?: "") + "SUT: ${params.SW_UNDER_TEST} Version: ${env.SUT_RELEASE} (${env.SUT_BUILD})<br />"
                }
            }

            // Graphic display
            junit testResults: 'validation/results.xml', skipPublishingChecks: true, skipMarkingBuildUnstable: true

        }
        success {
            echo 'The entire pipeline was successful'
        }
        failure {
            echo 'The pipeline failed'
        }
        cleanup {
            cleanWs()
        }
    }
}